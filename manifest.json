{
  "manifest_version": 3,
  "name": "crx 工具箱",
  "version": "1.0",
  "description": "页面小工具：静音控制台日志、京东订单一键评价、知乎伪装与图片精简",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "src/assets/icon.png",
      "48": "src/assets/icon.png",
      "128": "src/assets/icon.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.zhihu.com/*"],
      "js": ["zhihu-camouflage.js"],
      "css": ["zhihu-camouflage.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.zhihu.com/*"],
      "js": ["image-hiding.js"],
      "css": ["image-hiding.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["src/assets/doc-icon.svg"],
      "matches": ["*://*.zhihu.com/*"]
    }
  ],
  "icons": {
    "16": "src/assets/icon.png",
    "48": "src/assets/icon.png",
    "128": "src/assets/icon.png"
  }
}
